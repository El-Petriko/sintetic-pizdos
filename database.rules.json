{
  "rules": {
    "live": {
      "$sid": {
        ".read": "auth != null && $sid.length >= 20",
        ".write": "auth != null && data.child('owner').val() === auth.uid",
        "owner": {
          ".write": "auth != null && $sid.length >= 20 && !data.exists() && auth.uid === 'rYXL1ZGGjdhs39mDCvVXd1IIzKs1' && newData.val() === auth.uid"
        },
        "d": {
          "goals": {
            "$g": {
              ".write": "auth != null && root.child('live').child($sid).child('owner').exists() && root.child('live').child($sid).child('perm').child('goals').val() !== false && !data.exists()"
            }
          },
          "timer": {
            ".write": "auth != null && root.child('live').child($sid).child('owner').exists() && root.child('live').child($sid).child('perm').child('timer').val() !== false"
          },
          "game": {
            ".write": "auth != null && root.child('live').child($sid).child('owner').exists() && root.child('live').child($sid).child('perm').child('goals').val() !== false"
          },
          "playing": {
            ".write": "auth != null && root.child('live').child($sid).child('owner').exists() && root.child('live').child($sid).child('perm').child('goals').val() !== false"
          }
        },
        "lock": {
          ".write": "auth != null && root.child('live').child($sid).child('owner').exists() && root.child('live').child($sid).child('perm').child('goals').val() !== false"
        }
      }
    }
  }
}

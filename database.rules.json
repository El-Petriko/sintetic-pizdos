{
  "rules": {
    "live": {
      "$sid": {
        ".read": "auth != null && $sid.length >= 20",
        ".write": "auth != null && data.child('owner').val() === auth.uid",
        "owner": {
          ".write": "auth != null && $sid.length >= 20 && !data.exists() && auth.uid === 'rYXL1ZGGjdhs39mDCvVXd1IIzKs1' && newData.val() === auth.uid"
        },
        "d": {
          "goals": { ".write": "auth != null && root.child('live').child($sid).child('owner').exists()" },
          "timer": { ".write": "auth != null && root.child('live').child($sid).child('owner').exists()" },
          "game": { ".write": "auth != null && root.child('live').child($sid).child('owner').exists()" },
          "playing": { ".write": "auth != null && root.child('live').child($sid).child('owner').exists()" }
        },
        "lock": { ".write": "auth != null && root.child('live').child($sid).child('owner').exists()" }
      }
    }
  }
}
